# ===========================================================================
# Fantasy Coach — environment configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env` (which is git-ignored) and fill in real values.
#   cp .env.example .env          # macOS/Linux
#   Copy-Item .env.example .env   # PowerShell
#
# NEVER commit `.env`. It holds secrets. Treat CLIENT_ID / CLIENT_SECRET like
# passwords.
# ===========================================================================

# ---- Yahoo Developer app (REQUIRED to authenticate) -----------------------
# Create the app at https://developer.yahoo.com/apps/  (see README §Setup).
#   - Application Type: Web Application (so you get a Client Secret)
#   - API Permissions:  Fantasy Sports -> Read  (upgrade to Read/Write later)
YAHOO_CLIENT_ID=your-client-id-consumer-key-here
YAHOO_CLIENT_SECRET=your-client-secret-here

# Must EXACTLY match the Redirect URI (Callback Domain) registered on the app.
# Yahoo requires HTTPS. `oob` (copy/paste) is treated as deprecated — use a real
# redirect. We run no live server in M1; you paste the redirected URL back in.
YAHOO_REDIRECT_URI=https://localhost:8000/callback

# OAuth scope: fspt-r (read-only) or fspt-w (read/write — set lineups, add/drop).
# Start read-only; upgrade to fspt-w later when you want the coach to take moves.
YAHOO_SCOPE=fspt-r

# ---- League (optional now; needed by later modules) -----------------------
# Looks like `449.l.123456` = {game_key}.l.{league_id}. Discover it after login
# via the leagues endpoint (a helper lands in M2). Placeholder for now.
YAHOO_LEAGUE_KEY=

# ---- Token store (optional) -----------------------------------------------
# Where access+refresh tokens are persisted. Default: `.tokens.json` in the
# project root (git-ignored). Override to relocate outside the repo if you like.
# FANTASY_COACH_TOKEN_PATH=.tokens.json

# ---- Optional external data source keys (used by later modules, not M1) ----
ODDS_API_KEY=
FANTASYPROS_API_KEY=

# ---- Projections (optional) ------------------------------------------------
# Which ProjectionSource the value engine uses:
#   nflverse    (default) free model estimate from nflverse history — no key
#   fantasypros paid consensus — needs FANTASYPROS_API_KEY
# PROJECTION_SOURCE=nflverse

# Local data-cache directory (season projection caches live here, git-ignored).
# FANTASY_COACH_CACHE_DIR=.cache

# ---- Draft-value dials (optional; both off by default) ---------------------
# Playoff emphasis w in [0,1]: draft value = (1-w)*season VORP + w*playoff
# strength (needs the cached schedule; step 5). 0 = pure season value.
# PLAYOFF_EMPHASIS=0.25

# Injury/durability discount weight in [0,1] (step 6). 0 = risk flags shown
# but no value/rank change; 0.5-1.0 applies the documented status/durability
# discounts (Out/IR shaded hard, Questionable a mild haircut, chronic
# games-missed history a clamped nudge). Model estimates, honestly labelled.
# INJURY_EMPHASIS=0.6

# ---- Data store (optional) --------------------------------------------------
# The single-file SQLite store (league rules, players, ADP, projections, the
# value board). Git-ignored via *.sqlite3. Override to relocate.
# FANTASY_COACH_DB_PATH=data/coach.sqlite3
